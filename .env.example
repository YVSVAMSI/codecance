# Copy this file to .env and fill in real values.
# NEVER commit the real .env to the repository.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev (via docker-compose):
#   postgresql://postgres:postgres@localhost:5433/dsa_tracker?schema=public
# Production (Neon, Vercel Postgres, Supabase, etc.):
#   postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dsa_tracker?schema=public"

# ---------------------------------------------------------------------------
# Auth & security (use long random strings in production:
#   openssl rand -hex 48)
# ---------------------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
COOKIE_NAME="dsa_token"
# Production must set COOKIE_SECURE=true (or it auto-enables in production)
COOKIE_SECURE="false"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="5050"
# Comma-separated list of allowed front-end origins (Vite dev, prod domain)
CORS_ORIGIN="http://localhost:5173"

# Optional: API rate-limit tuning
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX="200"
# AUTH_RATE_LIMIT_WINDOW_MS="60000"
# AUTH_RATE_LIMIT_MAX="10"

# ---------------------------------------------------------------------------
# Email verification (OTP) via Resend — https://resend.com
# In development you can leave RESEND_API_KEY empty: the OTP will be printed
# to the server console instead of emailed. In production it is REQUIRED.
# EMAIL_FROM must be a verified sender domain in your Resend account.
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
EMAIL_FROM="CodeCance <onboarding@resend.dev>"
# Optional tuning:
# OTP_TTL_MS="900000"          # code valid for 15 min
# OTP_RESEND_COOLDOWN_MS="60000"
# OTP_MAX_ATTEMPTS="5"